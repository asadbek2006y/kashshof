{
  "name": "hamroh-api",
  "version": "0.1.0",
  "private": true,
  "description": "Hamroh API — NestJS REST backend: verified program data, matching engine, scripted assistant.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch --watch-path=src -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "contract:export": "node -r @swc-node/register scripts/export-openapi.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/adk": "2.1.0",
    "@google/genai": "2.24.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.0.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
