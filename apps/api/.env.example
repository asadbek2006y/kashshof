PORT=4100
APP_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://hamroh:hamroh@localhost:5433/hamroh?schema=public

# Assistant engine. With a key, Hamroh uses Gemini through Google ADK; without one (or with
# ASSISTANT_ENGINE=scripted) it uses the rule-based engine. Never commit a real key.
GEMINI_API_KEY=
# Comma-separated, tried in order.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
ASSISTANT_ENGINE=gemini
